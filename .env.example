# === Magic Kids Institute — daily YouTube Shorts pipeline ===
# Copy this file to `.env` and fill in the real values.

# --- LLM ---
OPENAI_API_KEY=sk-...

# --- AI visuals ---
FAL_API_KEY=fal_...

# --- Voice ---
ELEVENLABS_API_KEY=el_...
# Default voices (already set in code — override only if you want different ones):
# ELEVENLABS_VOICE_ID_EN=pMsXgVXv3BLzUgSXRplE   # Bella — warm kid-friendly female
# ELEVENLABS_VOICE_ID_AR=EXAVITQu4vr4xnSDxMaL   # Sarah — clear Arabic-optimized

# --- Supabase ---
SUPABASE_URL=https://imtpxkbimtolhvlyynvx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- YouTube ---
YT_PRIVACY=unlisted    # START WITH unlisted, flip to public after first video looks good

# --- Language mode ---
# "en" | "ar" | "auto" (alternates each day by day-of-year parity)
# For 2 videos/day (one EN + one AR), leave as "auto" and schedule cron TWICE per day
# (see docs/SETUP.md — cron section) — set RUN_LANGUAGE=en on one job, RUN_LANGUAGE=ar on the other.
RUN_LANGUAGE=auto
